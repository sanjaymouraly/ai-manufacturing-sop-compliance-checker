# ---------------------------------------------------------------------------
# Secrets - never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---------------------------------------------------------------------------
# Runtime state: database, uploaded documents, generated exports, caches
# ---------------------------------------------------------------------------
var/
!var/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Generated synthetic dataset (recreate with scripts/generate_dataset.py)
data/synthetic/

# Evaluation output. Keep the curated reports referenced by the docs; ignore
# ad-hoc runs written to eval_results/.
eval_results/

# Request log written by scripts/mock_llm_server.py
mock_llm_requests.jsonl
backend/eval/results/*
!backend/eval/results/deterministic.json
!backend/eval/results/llm_assisted_laguna.json
!backend/eval/results/llm_assisted_mock.json
*.eval.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Test and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
frontend/tsconfig.tsbuildinfo
frontend/*.tsbuildinfo

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/playwright/.cache/

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs and temporary files
