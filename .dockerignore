# Keep the build context small and secrets out of the image.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

node_modules
frontend/node_modules
frontend/dist
frontend/test-results
frontend/playwright-report
frontend/blob-report

# Never bake secrets or local state into an image
.env
.env.*
!.env.example
var/
eval_results/

docs/images
*.md
!README.md
.github
