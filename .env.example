# ---------------------------------------------------------------------------
# AI Manufacturing SOP Compliance Checker - example configuration
#
# Copy to .env and edit. Every value below is optional: with no .env at all the
# application runs fully offline using deterministic analysis only.
#
#   cp .env.example .env          (scripts/setup.sh does this for you)
#
# NEVER commit a real .env - it is listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Emit one JSON object per log line (useful when shipping logs to a collector).
LOG_JSON=false

# --- Security --------------------------------------------------------------
# REQUIRED IN PRODUCTION. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# scripts/setup.sh and setup.ps1 generate this automatically when creating .env.
SECRET_KEY=dev-insecure-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
JWT_ALGORITHM=HS256

# Comma-separated allow-list for browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# General API throttle, per client IP.
RATE_LIMIT_PER_MINUTE=240
# Sign-in brute-force guard, per client IP. Keep this tight. The E2E suite is the
# only reason to raise it (it signs in many times a minute).
LOGIN_RATE_LIMIT_PER_MINUTE=10

# First-run administrator. CHANGE THE PASSWORD BEFORE ANY REAL DEPLOYMENT.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin#12345

# --- Storage and database --------------------------------------------------
# Defaults to sqlite:///<repo>/var/app.db
# Postgres example: postgresql+psycopg://user:pass@localhost:5432/sopauditor
DATABASE_URL=
# Where the database, uploaded files, exports and caches live. Defaults to ./var
VAR_DIR=
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md,.csv,.json
# 0 keeps everything forever. Set a day count to prune old exports.
RETENTION_DAYS=0

# --- Analysis engine -------------------------------------------------------
# deterministic  = rule engine only, no network, fully reproducible (default)
# llm_assisted   = rule engine first, then an LLM pass for narrative findings
ANALYSIS_MODE=deterministic
# Similarity floor for pairing a report step with an SOP requirement (0-1).
EVIDENCE_MATCH_THRESHOLD=0.52
# Block any finding whose quote cannot be re-found in the stored source text.
# Leave this on. Turning it off allows unverifiable citations to be shown.
STRICT_CITATION_VERIFICATION=true
# OCR for scanned PDFs. Requires an OCR engine to be installed separately;
# when off, scanned pages are reported as unreadable rather than guessed at.
ENABLE_OCR=false

# --- AI provider -----------------------------------------------------------
# Keys are read by the backend only. They are never sent to the browser, never
# written to logs, exports or reports, and are stored encrypted at rest when set
# through the AI Provider Settings screen.
#
# offline     - deterministic stub, no network, no cost (default)
# openai      - api.openai.com
# anthropic   - api.anthropic.com
# openrouter  - openrouter.ai (OpenAI-compatible)
# custom      - any OpenAI-compatible endpoint (vLLM, LM Studio, Azure gateway...)
# ollama      - local Ollama server
LLM_PROVIDER=offline

# OpenRouter example:
#   LLM_PROVIDER=openrouter
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=openai/gpt-4o-mini
#
# Ollama example:
#   LLM_PROVIDER=ollama
#   LLM_BASE_URL=http://localhost:11434
#   LLM_MODEL=llama3.1:8b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
# Keep at 0 for reproducible analysis output.
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2

# Hard safety switch: while false, the application refuses to send any request
# that could be billed, including the "Test connection" button.
LLM_ALLOW_PAID_REQUESTS=false
# Spend ceiling in USD for a single analysis run.
#
# IMPORTANT: this only works for providers with published pricing. When a model
# has no known rate the pre-flight estimate is $0.00, so this cap can never be
# exceeded and is effectively inert -- which is the case for most gateways and
# every self-hosted endpoint. Use LLM_TOKEN_BUDGET whenever pricing is unknown.
LLM_REQUEST_BUDGET_USD=1.0
# Cumulative token ceiling. Needs no price list, so it bounds a run against any
# provider. Checked before the request is sent. 0 disables it.
# A single audit of a typical SOP costs roughly 2,000-4,000 tokens.
LLM_TOKEN_BUDGET=0
# Cache identical prompts so repeated runs cost nothing extra.
LLM_CACHE_ENABLED=true

# Sent as HTTP-Referer / X-Title by OpenRouter for attribution.
LLM_APP_REFERER=https://github.com/local/manufacturing-sop-ai-auditor
LLM_APP_TITLE=Manufacturing SOP AI Auditor

# --- Serving ---------------------------------------------------------------
# Serve the built frontend from the API process (single port deployment).
SERVE_FRONTEND=false
FRONTEND_DIST=
